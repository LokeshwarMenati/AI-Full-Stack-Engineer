# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/janaseva_ai

# Security & Authentication
JWT_SECRET=janaseva_ai_prototype_jwt_secret_dev_key_2026_kerala
