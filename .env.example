# Dual CAPTCHA Keys
# Cloudflare official testing keys:
# Site Key (Frontend): 1x00000000000000000000AA (always passes)
# Secret Key (Backend): 1x0000000000000000000000000000000AA (always passes)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google Gemini API (Provide key for real Gemini LLM calls, fallback enabled if absent)
